{
  "name": "internship-registration-explorer",
  "version": "0.1.0",
  "private": true,
  "description": "Mobile-first internship information site that hands registration off to the existing Google Form.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:release": "node scripts/build.mjs --release",
    "preview": "node scripts/build.mjs && node scripts/serve.mjs",
    "test": "node --test \"tests/unit/*.test.mjs\"",
    "test:e2e": "node scripts/build.mjs && node --test \"tests/e2e/*.test.mjs\""
  },
  "devDependencies": {
    "axe-core": "4.10.3",
    "playwright": "1.56.1"
  }
}
